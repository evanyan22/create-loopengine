ANTHROPIC_API_KEY=
# Using OpenAI instead? Swap agents/example-agent/index.ts's createModelCall
# for createOpenAIModelCall({ model: '...' }) and set this instead:
# OPENAI_API_KEY=

PORT=8787

# Optional — omit for local, file-based sessions under .sessions/. Set this
# once you run more than one server instance against the same sessions.
# REDIS_URL=redis://localhost:6379

# Optional, but set this before deploying anywhere reachable by anyone but
# you: without it, every route on this server — including each agent's
# conversation history — is wide open to anyone who can reach it.
# "user:pass" turns on HTTP Basic Auth for all of them.
# LOOPENGINE_ADMIN_AUTH=user:pass
